# Supabase
# Copy these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Storage bucket name (must match what you created in Supabase Storage)
NEXT_PUBLIC_STORAGE_BUCKET=project-documents

# Google Maps API key
# Create a browser key with Maps JavaScript API, Places API, and Geocoding API enabled
# Restrict by HTTP referrer to your domain for security
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
